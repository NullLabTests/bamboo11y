# Bamboo11y local configuration. Copy to .env and adjust as needed.
# Every setting uses the BAMBOO11Y_ prefix.

# --- application -----------------------------------------------------------
BAMBOO11Y_ENVIRONMENT=local
BAMBOO11Y_DATABASE_URL=sqlite:///./data/bamboo11y.db
BAMBOO11Y_SERVICE_CATALOG_PATH=config/services.yaml
BAMBOO11Y_STATIC_DIR=frontend/dist

# --- correlation -----------------------------------------------------------
BAMBOO11Y_CORRELATION_WINDOW_MINUTES=15
BAMBOO11Y_TOPOLOGY_CORRELATION_ENABLED=true
BAMBOO11Y_TOPOLOGY_WINDOW_MINUTES=10
BAMBOO11Y_CHANGE_CONTEXT_WINDOW_MINUTES=120
BAMBOO11Y_FUTURE_SKEW_TOLERANCE_SECONDS=300

# --- ingestion safety ------------------------------------------------------
BAMBOO11Y_RATE_LIMIT_PER_MINUTE=120
BAMBOO11Y_MAX_PAYLOAD_BYTES=1000000
BAMBOO11Y_MAX_ALERTS_PER_REQUEST=100

# --- HTTP / UI -------------------------------------------------------------
BAMBOO11Y_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
BAMBOO11Y_LOG_LEVEL=INFO
BAMBOO11Y_LOG_JSON=true

# --- notifications ---------------------------------------------------------
# The default is a credential-free mock-slack outbox. To exercise an HTTP
# receiver, point this at your local receiver (or the built-in mock endpoint).
BAMBOO11Y_NOTIFICATION_WEBHOOK_URL=
BAMBOO11Y_NOTIFICATION_TIMEOUT_SECONDS=5
